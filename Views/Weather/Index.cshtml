@{
    ViewData["Title"] = "WeatherWise";
}

<div class="hero text-center">
    <div class="container">
        <h1 class="display-5 fw-bold text-white">WeatherWise</h1>
        <p class="text-white-50 mb-4">Search for a city to view the latest weather conditions</p>

        <form id="search-form" class="search-form mx-auto" autocomplete="off">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text" id="city-input" class="form-control" placeholder="Search city... e.g. Durban" />
                <button type="submit" class="btn btn-primary" id="search-button">Search</button>
            </div>
        </form>
    </div>
</div>

<div class="container my-4">

    <!-- Empty state: shown before any search -->
    <div id="empty-state" class="text-center text-muted py-5">
        <p class="fs-5">Search for a city to view the latest weather conditions.</p>
    </div>

    <!-- Loading state -->
    <div id="loading-state" class="text-center py-5 d-none">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Loading weather...</p>
    </div>

    <!-- Error state -->
    <div id="error-state" class="alert alert-danger d-none" role="alert"></div>

    <!-- Weather results -->
    <div id="results" class="d-none">

        <div class="card weather-card shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h2 id="city-name" class="fw-bold mb-0"></h2>
                        <p id="condition-text" class="text-muted mb-3"></p>

                        <div class="d-flex align-items-center gap-3">
                            <img id="weather-icon" src="" alt="Weather icon" width="80" height="80" />
                            <span id="temperature" class="display-4 fw-bold"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row text-center g-3">
                            <div class="col-6 col-md-3">
                                <div class="stat-box">
                                    <div class="stat-label">Feels Like</div>
                                    <div id="feels-like" class="stat-value"></div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="stat-box">
                                    <div class="stat-label">Humidity</div>
                                    <div id="humidity" class="stat-value"></div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="stat-box">
                                    <div class="stat-label">Wind</div>
                                    <div id="wind-speed" class="stat-value"></div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="stat-box">
                                    <div class="stat-label">Pressure</div>
                                    <div id="pressure" class="stat-value"></div>
                                </div>
                            </div>
                        </div>

                        <div class="row text-center g-3 mt-1">
                            <div class="col-6">
                                <div class="stat-box">
                                    <div class="stat-label">Sunrise</div>
                                    <div id="sunrise" class="stat-value"></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-box">
                                    <div class="stat-label">Sunset</div>
                                    <div id="sunset" class="stat-value"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="mb-3">5-Day Forecast</h4>
        <div id="forecast-container" class="row g-3"></div>
    </div>

</div>